diff --git a/src/scenarios.zig b/src/scenarios.zig
index 21ecaad77c..2ee0d11fab 100644
--- a/src/scenarios.zig
+++ b/src/scenarios.zig
@@ -800,3 +800,92 @@
     os.settle();
     try testing.expectEqual(@as(u8, 0), engine.window_find(b).?.workspace);
 }
+
+test "with mouse follows-focus a focus command puts the mouse on the window it focuses" {
+    const os = boot("mouse follows-focus");
+    const app = os.app_launch("Ghostty", "com.mitchellh.ghostty");
+    const a = open(os, app, .{});
+    _ = open(os, app, .{});
+    os.settle();
+    const warps_before = os.mouse_warps;
+    os.command_run("focus west");
+    os.settle();
+    try testing.expectEqual(a, engine.focused_window);
+    try testing.expectEqual(warps_before + 1, os.mouse_warps);
+    try testing.expect(os.mouse_warp_last.eql(left_half));
+}
+
+test "with mouse follows-focus a swap puts the mouse where the focused window lands" {
+    const os = boot("mouse follows-focus");
+    const app = os.app_launch("Ghostty", "com.mitchellh.ghostty");
+    const a = open(os, app, .{});
+    _ = open(os, app, .{});
+    os.settle();
+    os.command_run("focus west");
+    os.settle();
+    const warps_before = os.mouse_warps;
+    os.command_run("swap east");
+    os.settle();
+    try testing.expectEqual(a, engine.focused_window);
+    try expect_frame(right_half, a);
+    try testing.expect(os.mouse_warps > warps_before);
+    try testing.expect(os.mouse_warp_last.eql(right_half));
+}
+
+test "with mouse follows-focus a workspace switch puts the mouse on the window it focuses" {
+    const os = boot("mouse follows-focus");
+    const app = os.app_launch("Ghostty", "com.mitchellh.ghostty");
+    const a = open(os, app, .{});
+    os.settle();
+    os.command_run("workspace 2");
+    os.settle();
+    const b = open(os, app, .{});
+    os.settle();
+    const warps_before = os.mouse_warps;
+    os.command_run("workspace 1");
+    os.settle();
+    try testing.expectEqual(a, engine.focused_window);
+    try testing.expect(os.mouse_warps > warps_before);
+    try testing.expect(os.mouse_warp_last.eql(screen));
+    _ = b;
+}
+
+test "with mouse follows-focus a click does not move the mouse" {
+    const os = boot("mouse follows-focus");
+    const app = os.app_launch("Ghostty", "com.mitchellh.ghostty");
+    const a = open(os, app, .{});
+    _ = open(os, app, .{});
+    os.settle();
+    const warps_before = os.mouse_warps;
+    os.window_click(a);
+    os.settle();
+    try testing.expectEqual(a, engine.focused_window);
+    try testing.expectEqual(warps_before, os.mouse_warps);
+}
+
+test "without mouse follows-focus focus commands leave the mouse alone" {
+    const os = boot("");
+    const app = os.app_launch("Ghostty", "com.mitchellh.ghostty");
+    _ = open(os, app, .{});
+    _ = open(os, app, .{});
+    os.settle();
+    os.command_run("focus west");
+    os.command_run("focus east");
+    os.command_run("workspace 2");
+    os.command_run("workspace 1");
+    os.settle();
+    try testing.expectEqual(@as(u64, 0), os.mouse_warps);
+}
+
+test "with mouse follows-focus a query does not move the mouse" {
+    const os = boot("mouse follows-focus");
+    const app = os.app_launch("Ghostty", "com.mitchellh.ghostty");
+    _ = open(os, app, .{});
+    _ = open(os, app, .{});
+    os.settle();
+    const warps_before = os.mouse_warps;
+    os.command_run("query windows");
+    os.command_run("query workspaces");
+    os.settle();
+    try testing.expectEqual(warps_before, os.mouse_warps);
+}
