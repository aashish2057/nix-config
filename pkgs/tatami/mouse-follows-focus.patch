+
+    fn focused_target(engine: *Engine) ?Rect {
+        const window = engine.window_find(engine.focused_window) orelse return null;
+        return engine.window_target(window);
+    }
+
+    fn mouse_follow_move(engine: *Engine, before: ?Rect) void {
+        const after = engine.focused_target() orelse return;
+        if (before) |frame| {
+            if (frame.eql(after)) return;
+        }
+        engine.mouse_warp_to = engine.focused_window;
+    }
+
+    fn mouse_warp_emit(engine: *Engine) void {
+        const id = engine.mouse_warp_to;
+        if (id == 0) return;
+        engine.mouse_warp_to = 0;
+        if (id != engine.focused_window) return;
+        const window = engine.window_find(id) orelse return;
+        if (!engine.workspace_visible(window.workspace)) return;
+        const target = engine.window_target(window) orelse return;
+        engine.emit(.{ .warp_mouse = target });
     }
 
